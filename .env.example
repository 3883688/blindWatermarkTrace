APP_NAME=WatermarkSystem
ENVIRONMENT=development
ADMIN_USER=
ADMIN_PASS=
UPLOAD_DIR=./uploads
DATA_DIR=./data
DB_ENABLED=true
DB_URL=
MEDIA_PUBLIC_BASE_URL=
V4_MODEL_MANIFEST_PATH=./models/v4-manifest.json
V4_SYNC_WORKER_QUOTA=1
V4_DEEP_WORKER_QUOTA=1
V4_SYNC_P95_SECONDS=120
V4_SYNC_TIMEOUT_SECONDS=300
V4_DEEP_TIMEOUT_SECONDS=1000
# PostgreSQL target used by tools/migrate_mysql_to_postgresql.py
POSTGRES_URL=
ENABLE_VISIBLE_WATERMARK_DETECTION=false
ENABLE_VISUAL_MATCH_FALLBACK=false
ENABLE_SMALL_CROP_TRACE_REDUNDANCY=true
ENABLE_ALIGNED_AUTHENTICATED_DETECTION=true
ENABLE_DENSE_WATERMARK_FALLBACK=false
ALIGNED_CANDIDATE_LIMIT=8
WATERMARK_DETECTION_BUDGET_SECONDS=5
ROBUST_WATERMARK_STRENGTH=0.74
ROBUST_WATERMARK_VERSION=4
WATERMARK_AUTH_KEY=
